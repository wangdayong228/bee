px var(--shadow); }\nnav button[aria-current='page'] svg { color: var(--accent-ink); }\n.sidebar-bottom { margin-top: auto; padding: 25px 4px 0; }\n.side-note { padding: 11px 5px 17px; font-size: 11px; color: var(--muted); }\n.side-note p { margin-top: 5px; }\n.dot { width: 6px; height: 6px; border-radius: 50%; background: var(--good); display: inline-block; margin-right: 6px; }\n.muted-dot { background: var(--muted); }\n.identity { display: flex; align-items: center; gap: 9px; border-top: 1px solid var(--line); padding-top: 16px; font-size: 12px; }\n.avatar { width: 28px; height: 28px; border: 1px solid var(--line); background: var(--paper); border-radius: 50%; display: grid; place-items: center; font-size: 11px; }\n.workspace { min-width: 0; background: var(--paper); display: flex; flex-direction: column; }\n.toolbar { height: 57px; min-height: 57px; padding: 0 27px; border-bottom: 1px solid var(--line); display: flex; align-items: center; justify-content: space-between; gap: 12px; }\n.breadcrumb, .toolbar-right, .device { display: flex; align-items: center; gap: 10px; font-size: 12px; color: var(--muted); }\n.breadcrumb span:last-child { color: var(--ink); }\n.breadcrumb svg { width: 12px; height: 12px; opacity: .6; }\n.device { font-size: 11px; gap: 6px; }\n.demo-badge { color: var(--accent-ink); background: var(--accent-soft); padding: 3px 8px; border-radius: 5px; font-size: 11px; white-space: nowrap; }\nmain { padding: 27px 30px 23px; flex: 1; min-width: 0; }\n.page-heading { display: flex; align-items: center; justify-content: space-between; gap: 14px; margin-bottom: 30px; }\n.page-heading p { margin-top: 4px; font-size: 12px; color: var(--muted); }\n.scene-control { display: grid; gap: 3px; font-size: 11px; color: var(--muted); }\nselect { background: var(--paper); border: 1px solid var(--line); border-radius: 5px; padding: 4px; font-size: 11px; }\n.running { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding-bottom: 26px; }\n.running-title { display: flex; align-items: center; gap: 17px; }\n.running-title h2 { font-size: 17px; margin-bottom: 4px; }\n.running-title p { color: var(--muted); font-size: 12px; }\n.emblem { width: 49px; height: 49px; border: 1px solid var(--line); border-radius: 15px; color: var(--good); background: var(--good-soft); display: grid; place-items: center; flex: none; }\n.emblem svg { width: 23px; height: 23px; }\n.health { display: flex; flex-wrap: wrap; gap: 8px 23px; margin-top: 16px; font-size: 11px; color: var(--muted); }\n.health span { display: flex; align-items: center; gap: 6px; }\n.health svg { width: 12px; height: 12px; color: var(--good); }\n.finance { display: grid; grid-template-columns: 1.2fr 1fr 1fr; padding: 23px 0 25px; gap: 25px; border-block: 1px solid var(--line); margin-bottom: 26px; }\n.finance p { font-size: 12px; color: var(--muted); margin-bottom: 7px; }\n.amount { font-size: 31px; font-weight: 400; letter-spacing: -1.1px; font-variant-numeric: tabular-nums; line-height: 1.15; overflow-wrap: anywhere; }\n.amount span { color: var(--muted); font-size: 13px; margin-right: 3px; vertical-align: 5px; letter-spacing: 0; }\n.finance small { margin-top: 9px; }\n.section-heading { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px; }\n.section-heading h2 { font-size: 13px; }\n.account-list { border: 1px solid var(--line); border-radius: 10px; }\n.account-row { padding: 19px 17px; display: grid; grid-template-columns: minmax(135px,1fr) minmax(90px,.7fr) auto; align-items: center; gap: 20px; }\n.account-row + .account-row { border-top: 1px solid var(--line); }\n.platform { display: flex; align-items: center; gap: 10px; }\n.platform-mark { width: 34px; height: 34px; border-radius: 10px; background: var(--faint); border: 1px solid var(--line); display: grid; place-items: center; font-size: 20px; }\n.platform-mark.claude { color: var(--accent-ink); background: var(--accent-soft); }\n.platform small { margin-top: 3px; }\n.plan { font-size: 11px; color: var(--muted); padding: 0 4px; border: 1px solid var(--line); border-radius: 3px; margin-left: 5px; font-weight: 400; }\n.account-condition { display: flex; align-items: center; gap: 5px; color: var(--good); font-size: 12px; }\n.account-condition svg { width: 13px; height: 13px; }\n.muted { color: var(--muted); font-size: 11px; }\n.bottomline { display: flex; align-items: center; justify-content: space-between; margin-top: 17px; color: var(--muted); font-size: 11px; }\nfooter { min-height: 31px; border-top: 1px solid var(--line); display: flex; align-items: center; justify-content: space-between; gap: 5px; padding: 6px 28px; background: var(--canvas); color: var(--muted); font-size: 11px; }\n.status-view { padding: 25px 20px; background: var(--canvas); border: 1px solid var(--line); border-radius: 10px; margin-bottom: 20px; }\n.status-view p { max-width: 65ch; color: var(--muted); margin-top: 7px; }\n.status-view button { margin-top: 12px; }\n.settings-list { border-block: 1px solid var(--line); }\n.settings-list > div { display: flex; justify-content: space-between; gap: 20px; padding: 18px 0; }\n.settings-list > div + div { border-top: 1px solid var(--line); }\n.settings-list span, .feature-note { color: var(--muted); font-size: 12px; }\n.feature-note { margin-top: 20px; }\n.operation-message { margin-top: 20px; padding: 12px; border-radius: 7px; background: var(--accent-soft); color: var(--accent-ink); font-size: 12px; }\n.dialog-overlay { position: fixed; inset: 0; z-index: 10; background: #151b294d; }\n.dialog-content, .detail-sheet { position: fixed; z-index: 11; background: var(--paper); color: var(--ink); border: 1px solid var(--line); box-shadow: 0 20px 60px var(--shadow); padding: 25px; }\n.dialog-content { top: 22%; left: 50%; transform: translateX(-50%); width: min(420px, calc(100vw - 32px)); border-radius: 12px; }\n.dialog-content h2, .detail-sheet h2 { font-size: 17px; margin-bottom: 10px; }\n.dialog-content p, 