id-column: 1 / -1; }\n.detail-sheet { overflow-y: auto; }\n@media (max-width: 900px) { .accounts-grid { grid-template-columns: 1fr; } }\n/* Earnings follows the approved silver reference: ruled summary, uneven panels, quiet forms. */\n.finance-heading { display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:16px; margin-bottom:26px; }\n.finance-heading h2 { font-size:21px; letter-spacing:-.5px; }\n.finance-heading p { color:var(--muted); font-size:12px; margin-top:6px; }\n.earnings-summary { margin-bottom:24px; border-bottom:1px solid var(--line); padding-bottom:24px; }\n.finance-filters { display:flex; align-items:center; justify-content:space-between; gap:16px; flex-wrap:wrap; color:var(--muted); font-size:12px; }\n.finance-filters select { padding:6px; border:1px solid var(--line); border-radius:6px; background:var(--paper); }\n.finance-filters button[aria-pressed=true] { color:var(--accent-ink); background:var(--accent-soft); }\n.earnings-panels { display:grid; grid-template-columns:1.35fr 1fr; gap:17px; margin:20px 0 26px; }\n.earnings-panel { border:1px solid var(--line); border-radius:9px; padding:19px; }\n.chart-total { font-size:24px; font-variant-numeric:tabular-nums; margin-top:10px; }\n.earnings-chart { height:128px; display:flex; align-items:flex-end; gap:8px; padding-top:14px; border-bottom:1px solid var(--line); }\n.earnings-chart>div { height:100%; display:flex; align-items:flex-end; flex:1; min-width:0; }\n.earnings-chart span { width:68%; max-width:32px; margin-inline:auto; background:var(--accent); border-radius:3px 3px 0 0; min-height:2px; opacity:.78; }\n.chart-axis { display:flex; justify-content:space-between; color:var(--muted); font-size:11px; margin-top:7px; }\n.finance-row { display:flex; align-items:center; justify-content:space-between; gap:15px; padding:14px 0; }\n.finance-row+ .finance-row { border-top:1px solid var(--line); }\n.finance-tabs { display:flex; gap:20px; border-bottom:1px solid var(--line); margin-bottom:18px; }\n.finance-tabs button { background:none; border:0; border-bottom:2px solid transparent; box-shadow:none; border-radius:0; padding:9px 0; color:var(--muted); }\n.finance-tabs button[aria-pressed=true] { color:var(--ink); border-bottom-color:var(--accent); }\n.finance-table { overflow-x:auto; }\n.finance-table table { border-collapse:collapse; width:100%; text-align:left; font-size:12px; font-variant-numeric:tabular-nums; }\n.finance-table th { color:var(--muted); font-weight:400; }\n.finance-table th,.finance-table td { border-bottom:1px solid var(--line); padding:13px 16px 13px 0; white-space:nowrap; }\n.finance-table th:last-child,.finance-table td:last-child { text-align:right; padding-right:0; }\n.finance-pagination { display:flex; justify-content:flex-end; align-items:center; gap:10px; margin-top:14px; color:var(--muted); font-size:11px; }\n.finance-note { color:var(--muted); font-size:12px; line-height:1.7; margin:12px 0; overflow-wrap:anywhere; }\n.finance-form { max-width:590px; }\n.finance-form fieldset { border:0; margin:0; padding:0; }\n.finance-summary-box { border:1px solid var(--line); border-radius:9px; padding:8px 20px; background:var(--canvas); margin:20px 0; }\n.finance-field { display:grid; gap:8px; margin-top:20px; font-size:12px; }\n.finance-field input { width:100%; font:inherit; color:var(--ink); padding:10px 12px; border:1px solid var(--line); border-radius:7px; background:var(--paper); }\n.finance-field .finance-row { padding:0; }\n.finance-actions { margin-top:23px; }\n.finance-error { color:var(--accent-ink); margin-top:14px; font-size:12px; overflow-wrap:anywhere; }\n.finance-back { margin-bottom:20px; }\n.quote-current { display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:8px; padding:14px 16px; background:var(--faint); border-radius:8px; margin:20px 0; font-size:12px; }\n.quote-choice { display:block; border:1px solid var(--line); border-radius:9px; padding:17px; margin-bottom:11px; }\n.quote-choice:has(input:checked) { background:var(--faint); }\n.quote-choice small { margin:6px 0 0 25px; }\n.quote-choice .finance-field { margin-left:25px; }\n.quote-preview { margin-top:24px; }\n.sr-only { position:absolute; width:1px; height:1px; padding:0; overflow:hidden; clip:rect(0,0,0,0); white-space:nowrap; }\n@media(max-width:850px) { .earnings-panels { grid-template-columns:1fr; } }\n@media(max-width:560px) { .earnings-summary { grid-template-columns:1fr; }.earnings-summary>div+div { border-left:0; padding-left:0; }.finance-heading .inline-actions { width:100%; }.finance-row { flex-wrap:wrap; } }\n.earnings-page button.primary:hover:not(:disabled) { background:var(--primary); }\n.settings-page { display: grid; gap: 18px; max-width: 820px; }\n.settings-page .settings-form { padding: 20px; background: var(--paper); border: 1px solid var(--line); border-radius: 12px; }\n.settings-page .check-label { display: flex; align-items: center; gap: 10px; }\n.settings-page input[type='checkbox'] { width: 16px; height: 16px; accent-color: var(--accent); }\n.diagnostics-page { display: grid; gap: 20px; }\n.diagnostics-page .settings-list { background: var(--paper); border-radius: 12px; padding: 20px; }\n.diagnostic-logs { margin: 0; padding: 16px 32px; background: var(--paper); border: 1px solid var(--line); border-radius: 10px; min-height: 60px; }\n\n/* Lifecycle previews share the silver shell and remain reachable in short windows. */\n.lifecycle-controls { border-top: 1px solid var(--line); margin-top: 24px; padding-top: 16px; }\n.lifecycle-controls .feature-note { margin-top: 10px; }\n.lifecycle-dialog { max-height: calc(100dvh - 32px); overflow-y: auto; top: 50%; transform: translate(-50%, -50%); }\n.lifecycle-dialog p { margin-top: 12px; line-height: 1.7; overflow-wrap: anywhere; }\n.dialog-actions { flex-wrap: wrap; }\n\n/* Adapt to the actual content width, including desktop page zoom. */\n.finance { grid-template-columns: repeat(auto-fit, minmax(min(100%, 170px), 1fr)); }\n.finance > div { min-width: 0; }\n.amount { white-space: nowrap; overflow-x: auto; overflow-wrap: normal; }\n\n.account-row { grid-template-columns: repeat(auto-fit, minmax(min(100%, 135px), 1fr)); }\n.platform-actions { min-width: 0; }\n"]],"\n  ",["BODY",{},"\n    ",["DIV",{"id":"root"},["DIV",{"class":"app-shell"},["ASIDE",{"class":"sidebar"},["DIV",{"class":"brand"},["IMG",{"__playwright_current_src__":"http://127.0.0.1:1420/src/assets/app-icon-dark.svg","alt":"","src":"/src/assets/app-icon-dark.svg"}],["SPAN",{},"Bee"]],["NAV",{"aria-label":"主导航"},["BUTTON",{"aria-current":"page"},["svg",{"xmlns":"http://www.w3.org/2000/svg","width":"24","height":"24","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"2","stroke-linecap":"round","stroke-linejoin":"round","class":"lucide lucide-layout-dashboard","aria-hidden":"true"},["rect",{"width":"7","height":"9","x":"3","y":"3","rx":"1"}],["rect",{"width":"7","height":"5","x":"14","y":"3","rx":"1"}],["rect",{"width":"7","height":"9","x":"14","y":"12","rx":"1"}],["rect",{"width":"7","height":"5","x":"3","y":"16","rx":"1"}]],"概览"],["BUTTON",{},["svg",{"xmlns":"http://www.w3.org/2000/svg","width":"24","height":"24","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"2","stroke-linecap":"round","stroke-linejoin":"round","class":"lucide lucide-users","aria-hidden":"true"},["path",{"d":"M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"}],["path",{"d":"M16 3.128a4 4 0 0 1 0 7.744"}],["path",{"d":"M22 21v-2a4 4 0 0 0-3-3.87"}],["circle",{"cx":"9","cy":"7","r":"4"}]],"AI 账号"],["BUTTON",{},["svg",{"xmlns":"http://www.w3.org/2000/svg","width":"24","height":"24","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"2","stroke-linecap":"round","stroke-linejoin":"round","class":"lucide lucide-circle-dollar-sign","aria-hidden":"true"},["circle",{"cx":"12","cy":"12","r":"10"}],["path",{"d":"M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8"}],["path",{"d":"M12 18V6"}]],"