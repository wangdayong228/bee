scheme: light; }\n:root[data-theme='dark'] { color-scheme: dark; }\n"],["STYLE",{},"* { box-sizing: border-box; }\nbody { margin: 0; }\nbutton, select { font: inherit; color: inherit; }\nbutton { cursor: pointer; min-height: 32px; padding: 6px 11px; border: 1px solid var(--line); border-radius: 7px; background: var(--paper); box-shadow: 0 1px 2px var(--shadow), inset 0 1px var(--sheen); font-size: 12px; }\nbutton:hover:not(:disabled) { background: var(--faint); }\nbutton:disabled { cursor: not-allowed; opacity: .5; }\n:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }\nbutton.primary { background: var(--primary); color: var(--on-primary); border-color: var(--primary); }\nbutton.primary:hover:not(:disabled) { filter: brightness(.94); }\nbutton.quiet { border-color: transparent; background: transparent; box-shadow: none; color: var(--muted); padding-inline: 5px; }\nh1,h2,h3,p { margin: 0; }\nh1 { font-size: 23px; font-weight: 500; letter-spacing: -.7px; }\nh2,h3 { font-size: 14px; font-weight: 500; letter-spacing: -.15px; }\nstrong { font-weight: 500; }\nsmall { display: block; color: var(--muted); font-size: 11px; }\nsvg { width: 16px; height: 16px; stroke-width: 1.65; flex: none; }\n.app-shell { display: grid; grid-template-columns: 178px minmax(0,1fr); min-height: 100dvh; }\n.sidebar { background: var(--side); border-right: 1px solid var(--line); padding: 28px 12px 15px; display: flex; flex-direction: column; }\n.brand { display: flex; align-items: center; gap: 10px; padding: 0 11px; margin-bottom: 27px; font-size: 23px; font-weight: 500; letter-spacing: -1px; }\n.brand img { width: 29px; height: 29px; border-radius: 8px; }\nnav { display: grid; gap: 5px; }\nnav button { display: flex; align-items: center; gap: 10px; border: 0; background: transparent; box-shadow: none; text-align: left; color: var(--muted); padding: 9px 12px; font-size: 13px; }\nnav button[aria-current='page'] { background: var(--selected); color: var(--ink); box-shadow: 0 1px 4px var(--shadow); }\nnav button[aria-current='page'] svg { color: var(--accent-ink); }\n.sidebar-bottom { margin-top: auto; padding: 25px 4px 0; }\n.side-note { padding: 11px 5px 17px; font-size: 11px; color: var(--muted); }\n.side-note p { margin-top: 5px; }\n.dot { width: 6px; height: 6px; border-radius: 50%; background: var(--good); display: inline-block; margin-right: 6px; }\n.muted-dot { background: var(--muted); }\n.identity { display: flex; align-items: center; gap: 9px; border-top: 1px solid var(--line); padding-top: 16px; font-size: 12px; }\n.avatar { width: 28px; height: 28px; border: 1px solid var(--line); background: var(--paper); border-radius: 50%; display: grid; place-items: center; font-size: 11px; }\n.workspace { min-width: 0; background: var(--paper); display: flex; flex-direction: column; }\n.toolbar { height: 57px; min-height: 57px; padding: 0 27px; border-bottom: 1px solid var(--line); display: flex; align-items: center; justify-content: space-between; gap: 12px; }\n.breadcrumb, .toolbar-right, .device { display: flex; align-items: center; gap: 10px; font-size: 12px; color: var(--muted); }\n.breadcrumb span:last-child { color: var(--ink); }\n.breadcrumb svg { width: 12px; height: 12px; opacity: .6; }\n.device { font-size: 11px; gap: 6px; }\n.demo-badge { color: var(--accent-ink); background: var(--accent-soft); padding: 3px 8px; border-radius: 5px; font-size: 11px; white-space: nowrap; }\nmain { padding: 27px 30px 23px; flex: 1; min-width: 0; }\n.page-heading { display: flex; align-items: center; justify-content: space-between; gap: 14px; margin-bottom: 30px; }\n.page-heading p { margin-top: 4px; font-size: 12px; color: var(--muted); }\n.scene-control { display: grid; gap: 3px; font-size: 11px; color: var(--muted); }\nselect { background: var(--paper); border: 1px solid var(--line); border-radius: 5px; padding: 4px; font-size: 11px; }\n.running { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding-bottom: 26px; }\n.running-title { display: flex; align-items: center; gap: 17px; }\n.running-title h2 { font-size: 17px; margin-bottom: 4px; }\n.running-title p { color: var(--muted); font-size: 12px; }\n.emblem { width: 49px; height: 49px; border: 1px solid var(--line); border-radius: 15px; color: var(--good); background: var(--good-soft); display: grid; place-items: center; flex: none; }\n.emblem svg { width: 23px; height: 23px; }\n.health { display: flex; flex-wrap: wrap; gap: 8px 23px; margin-top: 16px; font-size: 11px; color: var(--muted); }\n.health span { display: flex; align-items: center; gap: 6px; }\n.health svg { width: 12px; height: 12px; color: var(--good); }\n.finance { display: grid; grid-template-columns: 1.2fr 1fr 1fr; padding: 23px 0 25px; gap: 25px; border-block: 1px solid var(--line); margin-bottom: 26px; }\n.finance p { font-size: 12px; color: var(--muted); margin-bottom: 7px; }\n.amount { font-size: 31px; font-weight: 400; letter-spacing: -1.1px; font-variant-numeric: tabular-nums; line-height: 1.15; overflow-wrap: anywhere; }\n.amount span { color: var(--muted); font-size: 13px; margin-right: 3px; vertical-align: 5px; letter-spacing: 0; }\n.finance small { margin-top: 9px; }\n.section-heading { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px; }\n.section-heading h2 { font-size: 13px; }\n.account-list { border: 1px solid var(--line); border-radius: 10px; }\n.account-row { padding: 19px 17px; display: grid; grid-template-columns: minmax(135px,1fr) minmax(90px,.7fr) auto; align-items: center; gap: 20px; }\n.account-row + .account-row { border-top: 1px solid var(--line); }\n.platform { display: flex; align-items: center; gap: 10px; }\n.platform-mark { width: 34px; height: 34px; border-radius: 10px; background: var(--faint); border: 1px solid var(--line); display: grid; place-items: center; font-size: 20px; }\n.platform-mark.claude { color: var(--accent-ink); background: var(--accent-soft); }\n.platform small { margin-top: 3px; }\n.plan { font-size: 11px; color: var(--muted); padding: 0 4px; border: 1px solid var(--line); border-radius: 3px; margin-left: 5px; font-weight: 400; }\n.account-condition { display: flex; align-items: center; gap: 5px; color: var(--good); font-size: 12px; }\n.account-condition svg { width: 13px; height: 13px; }\n.muted { color: var(--muted); font-size: 11px; }\n.bottomline { display: flex; align-items: center; justify-content: space-between; margin-top: 17px; color: var(--muted); font-size: 11px; }\nfooter { min-height: 31px; border-top: 1px solid var(--line); display: flex; align-items: center; justify-content: space-between; gap: 5px; padding: 6px 28px; background: var(--canvas); color: var(--muted); font-size: 11px; }\n.status-view { padding: 25px 20px; background: var(--canvas); border: 1px solid var(--line); border-radius: 10px; margin-bottom: 20px; }\n.status-view p { max-width: 65ch; color: var(--muted); margin-top: 7px; }\n.status-view button { margin-top: 12px; }\n.settings-list { border-block: 1px solid var(--line); }\n.settings-list > div { display: flex; justify-content: space-between; gap: 20px; padding: 18px 0; }\n.settings-list > div + div { border-top: 1px solid var(--line); }\n.settings-list span, .feature-note { color: var(--muted); font-size: 12px; }\n.feature-note { margin-top: 20px; }\n.operation-message { margin-top: 20px; padding: 12px; border-radius: 7px; background: var(--accent-soft); color: var(--accent-ink); font-size: 12px; }\n.dialog-overlay { position: fixed; inset: 0; z-index: 10; background: #151b294d; }\n.dialog-content, .detail-sheet { position: fixed; z-index: 11; background: var(--paper); color: var(--ink); border: 1px solid var(--line); box-shadow: 0 20px 60px var(--shadow); padding: 25px; }\n.dialog-content { top: 22%; left: 50%; transform: translateX(-50%); width: min(420px, calc(100vw - 32px)); border-radius: 12px; }\n.dialog-content h2, .detail-sheet h2 { font-size: 17px; margin-bottom: 10px; }\n.dialog-content p, .detail-sheet p { color: var(--muted); font-size: 12px; }\n.dialog-actions { display: flex; justify-content: flex-end; gap: 8px; margin-top: 24px; }\n.detail-sheet { inset: 0 0 0 auto; width: min(420px, 100vw); }\n.detail-sheet header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px; }\ndt { color: var(--muted); font-size: 12px; margin-top: 25px; }\ndd { margin: 7px 0 0; overflow-wrap: anywhere; }\n@media (max-width: 700px) {\n  .app-shell { grid-template-columns: 142px minmax(0,1fr); }\n  .sidebar { padding-inline: 8px; }.brand { padding-inline: 5px; }\n  main { padding: 22px 18px; }.toolbar { padding-inline: 18px; }.device { display: none; }\n  .running { align-items: flex-start; flex-direction: column; }.running-title { gap: 10px; }\n  .finance { gap: 12px; }.amount { font-size: 24px; }.finance small { font-size: 10px; }\n  .account-row { grid-template-columns: 1fr; gap: 10px; }.account-row > .muted { display: none; }\n  .page-heading { align-items: flex-start; flex-direction: column; }.scene-control { display: flex; align-items: center; }\n  footer { padding-inline: 18px; flex-wrap: wrap; }.side-note { font-size: 10px; }\n}\n.onboarding { border: 1px solid var(--line); border-radius: 10px; padding: 20px; margin-bottom: 25px; background: var(--canvas); }\n.guide-steps { padding-left: 20px; margin-bottom: 0; }\n.guide-steps li { padding: 12px 0 12px 5px; border-top: 1px solid var(--line); }\n.guide-steps li > span { display: block; margin: 4px 0 10px; font-size: 12px; color: var(--muted); }\n.inline-actions { display: flex; gap: 8px; flex-wrap: wrap; }\n.connection-summary { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; padding: 0 0 22px; color: var(--muted); font-size: 12px; }\n.connection-summary .inline-actions { margin-left: auto; }\n.platform-actions { display: grid; gap: 8px; font-size: 11px; }\n.platform-actions label { display: flex; gap: 4px; align-items: center; color: var(--muted); }\n.quota-label { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: baseline; gap: 8px; }\n.quota-value { font-size: 12px; white-space: nowrap; font-variant-numeric: tabular-nums; }\n.quota-meter { appearance: none; display: block; width: 100%; height: 4px; margin: 5px 0; border: 0; border-radius: 3px; background: var(--faint); }\n.quota-meter::-webkit-meter-inner-element { display: block; }\n.quota-meter::-webkit-meter-bar { height: 4px; border: 0; border-radius: inherit; background: var(--faint); box-shadow: none; }\n.quota-meter::-webkit-meter-optimum-value { border-radius: inherit; background: var(--accent); opacity: .8; }\n.quota-meter::-moz-meter-bar { border-radius: inherit; background: var(--accent); opacity: .8; }\n.platform-feedback { max-width: 32ch; margin-top: 5px; }\n.settings-form { max-width: 550px; display: grid; gap: 20px; }\n.settings-form label { display: grid; gap: 8px; font-size: 12px; }\n.settings-form input { background: var(--paper); color: var(--ink); border: 1px solid var(--line); border-radius: 7px; padding: 9px; font: inherit; }\n.settings-form button { justify-self: start; }\n.accounts-intro { color: var(--muted); font-size: 12px; max-width: 65ch; margin-bottom: 22px; line-height: 1.8; }\n.accounts-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; }\n.account-card { border: 1px solid var(--line); border-radius: 10px; padding: 20px; background: var(--paper); }\n.account-identifier { font-size: 13px; overflow-wrap: anywhere; margin: 20px 0 10px; }\n.account-state { font-size: 12px; margin-bottom: 10px; }\n.account-card > button { margin-top: 18px; }\n.account-card .inline-actions { border-top: 1px solid var(--line); padding-top: 18px; margin-top: 18px; }\n.account-models { margin-top: 28px; }\n.model-row { padding: 16px 0; border-bottom: 1px solid var(--line); font-size: 12px; display: grid; grid-template-columns: 1fr auto; gap: 8px; }\n.model-row span { color: var(--muted); }.model-row small { grid-column: 1 / -1; }\n.detail-sheet { overflow-y: auto; }\n@media (max-width: 900px) { .accounts-grid { grid-template-columns: 1fr; } }\n/* Earnings follows the approved silver reference: ruled summary, uneven panels, quiet forms. */\n.finance-heading { display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:16px; margin-bottom:26px; }\n.finance-heading h2 { font-size:21px; letter-spacing:-.5px; }\n.finance-heading p { color:var(--muted); font-size:12px; margin-top:6px; }\n.earnings-summary { margin-bottom:24px; border-bottom:1px solid var(--line); padding-bottom:24px; }\n.finance-filters { display:flex; align-items:center; justify-content:space-between; gap:16px; flex-wrap:wrap; color:var(--muted); font-size:12px; }\n.finance-filters select { padding:6px; border:1px solid var(--line); border-radius:6px; background:var(--paper); }\n.finance-filters button[aria-pressed=true] { color:var(--accent-ink); background:var(--accent-soft); }\n.earnings-panels { display:grid; grid-template-columns:1.35fr 1fr; gap:17px; margin:20px 0 26px; }\n.earnings-panel { border:1px solid var(--line); border-radius:9px; padding:19px; }\n.chart-total { font-size:24px; font-variant-numeric:tabular-nums; margin-top:10px; }\n.earnings-chart { height:128px; display:flex; align-items:flex-end; gap:8px; padding-top:14px; border-bottom:1px solid var(--line); }\n.earnings-chart>div { height:100%; display:flex; align-items:flex-end; flex:1; min-width:0; }\n.earnings-chart span { width:68%; max-width:32px; margin-inline:auto; background:var(--accent); border-radius:3px 3px 0 0; min-height:2px; opacity:.78; }\n.chart-axis { display:flex; justify-content:space-between; color:var(--muted); font-size:11px; margin-top:7px; }\n.finance-row { display:flex; align-items:center; justify-content:space-between; gap:15px; padding:14px 0; }\n.finance-row+ .finance-row { border-top:1px solid var(--line); }\n.finance-tabs { display:flex; gap:20px; border-bottom:1px solid var(--line); margin-bottom:18px; }\n.finance-tabs button { background:none; border:0; border-bottom:2px solid transparent; box-shadow:none; border-radius:0; padding:9px 0; color:var(--muted); }\n.finance-tabs button[aria-pressed=true] { color:var(--ink); border-bottom-color:var(--accent); }\n.finance-table { overflow-x:auto; }\n.finance-table table { border-collapse:collapse; width:100%; text-align:left; font-size:12px; font-variant-numeric:tabular-nums; }\n.finance-table th { color:var(--muted); font-weight:400; }\n.finance-table th,.finance-table td { border-bottom:1px solid var(--line); padding:13px 16px 13px 0; white-space:nowrap; }\n.finance-table th:last-child,.finance-table td:last-child { text-align:right; padding-right:0; }\n.finance-pagination { display:flex; justify-content:flex-end; align-items:center; gap:10px; margin-top:14px; color:var(--muted); font-size:11px; }\n.finance-note { color:var(--muted); font-size:12px; line-height:1.7; margin:12px 0; overflow-wrap:anywhere; }\n.finance-form { max-width:590px; }\n.finance-form fieldset { border:0; margin:0; padding:0; }\n.finance-summary-box { border:1px solid var(--line); border-radius:9px; padding:8px 20px; background:var(--canvas); margin:20px 0; }\n.finance-field { display:grid; gap:8px; margin-top:20px; font-size:12px; }\n.finance-field input { width:100%; font:inherit; color:var(--ink); padding:10px 12px; border:1px solid var(--line); border-radius:7px; background:var(--paper); }\n.finance-field .finance-row { padding:0; }\n.finance-actions { margin-top:23px; }\n.finance-error { color:var(--accent-ink); margin-top:14px; font-size:12px; overflow-wrap:anywhere; }\n.finance-back { margin-bottom:20px; }\n.quote-current { display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:8px; padding:14px 16px; background:var(--faint); border-radius:8px; margin:20px 0; font-size:12px; }\n.quote-choice { display:block; border:1px solid var(--line); border-radius:9px; padding:17px; margin-bottom:11px; }\n.quote-choice:has(input:checked) { background:var(--faint); }\n.quote-choice small { margin:6px 0 0 25px; }\n.quote-choice .finance-field { margin-left:25px; }\n.quote-preview { margin-top:24px; }\n.sr-only { position:absolute; width:1px; height:1px; padding:0; overflow:hidden; clip:rect(0,0,0,0); white-space:nowrap; }\n@media(max-width:850px) { .earnings-panels { grid-template-columns:1fr; } }\n@media(max-width:560px) { .earnings-summary { grid-template-columns:1fr; }.earnings-summary>div+div { border-left:0; padding-left:0; }.finance-heading .inline-actions { width:100%; }.finance-row { flex-wrap:wrap; } }\n.earnings-page button.primary:hover:not(:disabled) { background:var(--primary); }\n.settings-page { display: grid; gap: 18px; max-width: 820px; }\n.settings-page .settings-form { padding: 20px; background: var(--paper); border: 1px solid var(--line); border-radius: 12px; }\n.settings-page .check-label { display: flex; align-items: center; gap: 10px; }\n.settings-page input[type='checkbox'] { width: 16px; height: 16px; accent-color: var(--accent); }\n.diagnostics-page { display: grid; gap: 20px; }\n.diagnostics-page .settings-list { background: var(--paper); border-radius: 12px; padding: 20px; }\n.diagnostic-logs { margin: 0; padding: 16px 32px; background: var(--paper); border: 1px solid var(--line); border-radius: 10px; min-height: 60px; }\n\n/* Lifecycle previews share the silver shell and remain reachable in short windows. */\n.lifecycle-controls { border-top: 1px solid var(--line); margin-top: 24px; padding-top: 16px; }\n.lifecycle-controls .feature-note { margin-top: 10px; }\n.lifecycle-dialog { max-height: calc(100dvh - 32px); overflow-y: auto; top: 50%; transform: translate(-50%, -50%); }\n.lifecycle-dialog p { margin-top: 12px; line-height: 1.7; overflow-wrap: anywhere; }\n.dialog-actions { flex-wrap: wrap; }\n\n/* Adapt to the actual content width, including desktop page zoom. */\n.finance { grid-template-columns: repeat(auto-fit, minmax(min(100%, 170px), 1fr)); }\n.finance > div { min-width: 0; }\n.amount { white-space: nowrap; overflow-x: auto; overflow-wrap: normal; }\n\n.account-row { grid-template-columns: repeat(auto-fit, minmax(min(100%, 135px), 1fr)); }\n.platform-actions { min-width: 0; }\n"]],"\n  ",["BODY",{},"\n    ",["DIV",{"id":"root"},["DIV",{"class":"app-shell"},["ASIDE",{"class":"sidebar"},["DIV",{"class":"brand"},["IMG",{"__playwright_current_src__":"http://127.0.0.1:1420/src/assets/app-icon-dark.svg","alt":"","src":"/src/assets/app-icon-dark.svg"}],["SPAN",{},"Bee"]],["NAV",{"aria-label":"主导航"},["BUTTON",{"aria-current":"page"},["svg",{"xmlns":"http://www.w3.org/2000/svg","width":"24","height":"24","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"2","stroke-linecap":"round","stroke-linejoin":"round","class":"lucide lucide-layout-dashboard","aria-hidden":"true"},["rect",{"width":"7","height":"9","x":"3","y":"3","rx":"1"}],["rect",{"width":"7","height":"5","x":"14","y":"3","rx":"1"}],["rect",{"width":"7","height":"9","x":"14","y":"12","rx":"1"}],["rect",{"width":"7","height":"5","x":"3","y":"16","rx":"1"}]],"概览"],["BUTTON",{},["svg",{"xmlns":"http://www.w3.org/2000/svg","width":"24","height":"24","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"2","stroke-linecap":"round","stroke-linejoin":"round","class":"lucide lucide-users","aria-hidden":"true"},["path",{"d":"M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"}],["path",{"d":"M16 3.128a4 4 0 0 1 0 7.744"}],["path",{"d":"M22 21v-2a4 4 0 0 0-3-3.87"}],["circle",{"cx":"9","cy":"7","r":"4"}]],"AI 账号"],["BUTTON",{},["svg",{"xmlns":"http://www.w3.org/2000/svg","width":"24","height":"24","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"2","stroke-linecap":"round","stroke-linejoin":"round","class":"lucide lucide-circle-dollar-sign","aria-hidden":"true"},["circle",{"cx":"12","cy":"12","r":"10"}],["path",{"d":"M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8"}],["path",{"d":"M12 18V6"}